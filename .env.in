# Capture local values specific to this checkout:
TZ=${TZ}
PUID=${PUID}
PGID=${PGID}

# Release Secrets:
# Best to create and use a token. Note that the token must have the `admin`/"Read,
# Write, Delete" from "ACCESS PERMISSIONS":
# https://hub.docker.com/settings/security?generateToken=true
DOCKER_PASS=${DOCKER_PASS}

# Constants specific to this project or checkout used in variable substitutions in
# `./compose*.yml`. Don't change these during the ordinary course of development:
# Capture the path of the checkout directory as seen by the real host running `#
# dockerd` so that following bind volumes have the correct source paths:
CHECKOUT_DIR=${CHECKOUT_DIR}
WORKTREE_REL=${WORKTREE_REL}
# The Docker Hub user or organization:
DOCKER_NAMESPACE=${DOCKER_NAMESPACE}
# Build host variables, used only for reproducing CI/CD locally:
DOCKER_GID=${DOCKER_GID}
# Pin container image versions to avoid failures from external changes:
DOCKER_BASE_DIGEST=@sha256:c15cf15316aab40fffa9fb71bd6b1c2d576bc41d1a49a7c24eefbb6f75503096
DOCKER_DOCKER_PUSHRM_DIGEST=@sha256:812a950e5be7dca26cef33b61eb2076bfcfb6c2a8ec96c126371fc049c3b6608
DOCKER_GITLAB_RELEASE_CLI_DIGEST=@sha256:3e039d265e8c3a263625ef788c35060968e189360051889968c22b00db49f48c
DOCKER_HADOLINT_DIGEST=@sha256:9cef74a390694cdc01dd119cbba9adac5bb6671ce67d8d79eb7ec68f497a3684
DOCKER_PANDOC_DIGEST=@sha256:7b3b06bebf6667ae19c0979fb97459fa10ae8686bf1831717ed8aae56df839ec
DOCKER_REUSE_DIGEST=@sha256:7928d25ed14a1bc22758d917ebc6aecbb8bcd1a4da7aa748d7179c9011bbfb0b
